        <!--                {% else %}-->
        <!--                <p>Showing <strong>20</strong> materials out of-->
        <!--                    <strong>20</strong></p>-->
        <!--                {% endif %}-->
        <!--            </div>-->
        <!--        </div>-->
        <div class="actions_holder">
            <div class="dcf-viewer__toolbar govuk-!-margin-bottom-4 govuk-body">
                <a href="#" id="show_filter_Materials" class="govuk-link"
                   data-module="govuk-button">Show
                    filter</a>
                <a href="#" id="close_filter_Materials" class="govuk-link"
                   data-module="govuk-button">Hide
                    filter</a>
                <span aria-hidden="true"
                      class="govuk-!-margin-horizontal-2"
                      data-toolbar-control="close-viewer-separator">&nbsp; | &nbsp;</span>
                <a href="#" class="govuk-link" data-action="close-viewer"
                   data-toolbar-control="close-viewer">Close
                    all documents</a>
                <span aria-hidden="true"
                      class="govuk-!-margin-horizontal-2"
                      data-toolbar-control="toggle-full-separator">&nbsp; | &nbsp;</span>
                <a href="#" class="govuk-link" data-action="toggle-full"
                   data-toolbar-control="toggle-full"
                   aria-pressed="false">
                    View document full width
                </a>

                <span class="dcf-viewer__toolbar-right">
                        <a href="#" class="govuk-link"
                           data-action="back-to-search"
                           hidden>Back to search results</a>
                        <span aria-hidden="true"
                              class="govuk-!-margin-horizontal-2"
                              data-role="back-to-search-sep" hidden>&nbsp; | &nbsp;</span>
                        <span class="dcf-viewer__navcluster"
                              data-role="search-nav"></span>
                    </span>
                <div class="moj-button-menu">
                    <button type="button"
                            class="govuk-button govuk-button--secondary"
                            data-module="govuk-button"
                            id="show_Materials_Actions">
                        Actions on selection
                        <svg width="11" height="5" viewBox="0 0 11 5"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M5.5 0L11 5L0 5L5.5 0Z"
                                  fill="currentColor"></path>
                        </svg>
                    </button>
                    <div class="hidden_buttons" id="materials_Actions">
                        <!-- Rename should only be available for single selections, not multiple -->
                        <button type="button"
                                class="govuk-button govuk-button--disabled rename_Document_Multiple_Docs rename-Document"
                                data-module="govuk-button"
                                onclick="openRenameModal(); documentRename();">
                            Rename
                        </button>

                        <button type="button" id="update-and-reclassify"
                                class="govuk-button govuk-button--disabled reclassify_Document_Multiple_Docs"
                                data-module="govuk-button" disabled>
                            Reclassify
                        </button>

                        <!-- Update should only be available for Statements or Exhibits -->
                        <button type="button" id="update-statement"
                                class="govuk-button govuk-button--disabled reclassify_Document_Multiple_Docs"
                                data-module="govuk-button"
                                onclick="openUpdateStatement(); documentUpdateStatement();"
                                disabled>Update statement
                        </button>

                        <button type="button" id="update-exhibit"
                                class="govuk-button govuk-button--disabled reclassify_Document_Multiple_Docs"
                                data-module="govuk-button"
                                onclick="openUpdateExhibit();"
                                disabled>Update exhibit
                        </button>

                        <button type="button"
                                class="govuk-button govuk-button--disabled redact_Document_Multiple_Docs"
                                data-module="govuk-button" disabled>Redact
                        </button>

                        <form method="post"
                              action="/version-2/B-discard_material?version={{ version }}">
                            <input id="material_selected"
                                   name="material_selected" type="hidden"
                                   value="">
                            <input name="discard_origin" type="hidden"
                                   value="materials">
                            <button class="govuk-button govuk-button--disabled reclassify_Document_Multiple_Docs"
                                    data-module="govuk-button" type="submit"
                                    disabled>Discard
                            </button>
                        </form>

                        <button class="govuk-button mark_as_Read govuk-button--disabled reclassify_Document_Multiple_Docs"
                                data-module="govuk-button" type="button"
                                disabled>Mark as read
                        </button>

                        <button type="button"
                                class="govuk-button govuk-button--disabled unused_Materials_Multiple_Docs"
                                data-module="govuk-button" disabled>Mark as
                            unused
                        </button>

                        <button type="button"
                                class="govuk-button govuk-button--disabled reclassify_Document_Multiple_Docs open-Document"
                                data-module="govuk-button"
                                onclick="return openDocumentInNewWindow();">
                            View in new window
                        </button>
                    </div>
                </div>
                <div class="moj-button-menu dropdown">
                    <button type="button"
                            class="govuk-button dropbtn govuk-button--secondary"
                            data-module="govuk-button"
                            id="show_Document_Actions">
                        Document actions
                        <svg width="11" height="5" viewBox="0 0 11 5"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M5.5 0L11 5L0 5L5.5 0Z"
                                  fill="currentColor"></path>
                        </svg>
                    </button>
                    <div class="hidden_buttons dropdown-content"
                         id="myDropdown1">
                        <button onclick="openModalOver(); documentTitle();"
                                class="">Log an Under/Over redaction
                        </button>
                        <!-- <button onclick="window.open(#)" class="">View redaction log history</button>-->
                        <!-- <button onclick="suggestedRedactions()" class="suggested-redactions" id="suggestedRedactions">Turn <strong>ON</strong> Potential redactions</button>-->
                        <button onclick="openRotatePagesModal(); documentTitle();"
                                class="remove-rotate-pages-modal">Rotate
                            document pages
                        </button>

                        <button onclick="location.href='/version-2/B-discard_material?version=2.2';">
                            Discard
                        </button>
                        <button onclick="">Reclassify</button>

                        <button class="govuk-button mark_as_Read"
                                data-module="govuk-button" type="button">Mark as
                            read
                        </button>
                        <button onclick="openRenameModal(); documentRename();"
                                class="rename-Document">Rename
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="materials_content"
     class="govuk-grid-row dcf-materials-workspace dcf-materials-workspace--v2-1">
    <div id="materials_column_1"
         class="govuk-grid-column-one-quarter dcf-materials-workspace__filter"
         data-panel="materials-filter">
        <div class="moj-filter-layout__filter">
            {% include "versions/v2/v2-2/includes/materials-filter.njk" %}
        </div>
    </div>
    <div id="filter_Redactions"
         class="govuk-grid-column-full-from-desktop dcf-materials-workspace__table"
         data-panel="materials-table">

        {# ---- v2.1: Materials grouped by category using GOV.UK Accordion ----
        #}

        {% set _caseOverviewContent %}
        {% set hasCaseOverview = false %}
        {% for item in data['cases']['material'] %}
        {% if item.category | lower == 'case overview' %}
        {% set hasCaseOverview = true %}
        {% endif %}
        {% endfor %}
        <table class="govuk-table sortable app-responsive-table {% if not hasCaseOverview %}govuk-!-display-none{% endif %}">
            <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">
                    <div class="govuk-checkboxes govuk-checkboxes--small MT-15"
                         data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input"
                                   name="materials_document" type="checkbox"
                                   value="Select all">
                            <label class="govuk-label govuk-checkboxes__label"></label>
                        </div>
                    </div>
                </th>
                <th scope="col" class="govuk-table__header">Material</th>
                <th scope="col" class="govuk-table__header">Type</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Reference</th>
                <th scope="col" class="govuk-table__header">Date</th>
                <th scope="col" class="govuk-table__header">Notes</th>
            </tr>
            </thead>
            <tbody class="govuk-table__body">
            {% for item in data['cases']['material'] %}
            {% if item.category | lower == 'case overview' %}
            <tr class="govuk-table__row document_row_1 material_Review material_None material_New material_All unread_document">
                <td data-label="checkbox" class="govuk-table__cell">
                    <div class="govuk-checkboxes govuk-checkboxes--small"
                         data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input"
                                   id="materials_document_c{{ item.dataId }}"
                                   name="materials_document" type="checkbox"
                                   value="{{ item.dataDoc }}">
                            <label class="govuk-label govuk-checkboxes__label"
                                   for="materials_document_c{{ item.dataId }}"><span
                                    class="visuallyhidden">{{ item.title }}</span></label>
                        </div>
                    </div>
                </td>
                <td data-label="title" class="govuk-table__cell title_column">
                    {% if item.new == true %}<strong
                        class="govuk-tag govuk-tag--blue">New</strong>{% endif
                    %}
                    <div class="openMe">
                        <a class="govuk-button show_material show-case"
                           data-id="{{ item.dataId }}"
                           data-doc="{{ item.dataDoc }}">{{ item.title }}</a>
                    </div>
                </td>
                <td data-label="type" class="govuk-table__cell">{{ item.type
                    }}
                </td>
                <td data-label="status" class="govuk-table__cell">
                    <strong class="govuk-tag {% if item.status == 'Used' %}govuk-tag--blue{% elif item.status == 'Unused' %}govuk-tag--yellow{% else %}govuk-tag--grey{% endif %}">{{
                        item.status }}</strong>
                </td>
                <td data-label="reference" class="govuk-table__cell">{{
                    item.reference }}
                </td>
                <td data-label="date" class="govuk-table__cell">{{ item.date
                    }}
                </td>
                <td data-label="notes" class="govuk-table__cell toggle-panel">
                    <a href="#"
                       class="govuk-link notes-link new-notes-link exhibit-notes"
                       onClick="openNewNotesModal(); return false;"><span
                            class="notes-text">Show notes</span></a>
                </td>
            </tr>
            {% endif %}
            {% endfor %}
            </tbody>
        </table>
        {% if not hasCaseOverview %}
        <p class="govuk-body">There are no case overview materials
            available.</p>
        {% endif %}
        {% endset %}

