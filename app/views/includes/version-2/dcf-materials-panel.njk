{# app/views/_shared/_components/material-panel/template.njk #}

{% from "govuk/components/accordion/macro.njk" import govukAccordion %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{# expects: params.caseMaterials = { caseId, caseStatus, Material: [...] , RelatedMaterials, DigitalRepresentation, PoliceMaterial, CPSMaterial } #}
{#          params.generateDocuments = { caseDocuments: [...], defendants: [...], witnesses: [...] } #}

{# ---------- data + helpers ---------- #}
{% set cm     = params.caseMaterials or {} %}
{% set items  = cm.Material or [] %}
{% set gd     = params.generateDocuments or {} %}

{% set statementsCount = 0 %}
{% set exhibitsCount = 0 %}
{% set unsNonSensitiveCount = 0 %}
{% set sensitiveCount = 0 %}
{% set otherCount = 0 %}
{% set mgFormsCount = 0 %}

{% for m in items %}
    {% set t = (m.Type | lower) %}
    {% if t == 'statement' %}{% set statementsCount = statementsCount + 1 %}{% endif %}
    {% if t == 'exhibit' %}{% set exhibitsCount = exhibitsCount + 1 %}{% endif %}
    {% if t == 'unused non-sensitive' %}{% set unsNonSensitiveCount = unsNonSensitiveCount + 1 %}{% endif %}

    {# Support both "Sensitive" and "Unused sensitive" just in case #}
    {% if t == 'sensitive' or t == 'unused sensitive' %}{% set sensitiveCount = sensitiveCount + 1 %}{% endif %}

    {% if t == 'other material' %}{% set otherCount = otherCount + 1 %}{% endif %}
    {% if t == 'mg forms' %}{% set mgFormsCount = mgFormsCount + 1 %}{% endif %}
{% endfor %}

{# ✅ MUST be after the loop, otherwise it stays 0 #}
{% set unusedCount = unsNonSensitiveCount + sensitiveCount %}

{# ---------- CPS generated documents count ---------- #}
{% set cpsDocsCount = 0 %}
{% for doc in (gd.caseDocuments or []) %}
    {% if doc.lastGenerated %}{% set cpsDocsCount = cpsDocsCount + 1 %}{% endif %}
{% endfor %}
{% for defendant in (gd.defendants or []) %}
    {% for doc in (defendant.documents or []) %}
        {% if doc.lastGenerated %}{% set cpsDocsCount = cpsDocsCount + 1 %}{% endif %}
    {% endfor %}
{% endfor %}
{% for witness in (gd.witnesses or []) %}
    {% for doc in (witness.documents or []) %}
        {% if doc.lastGenerated %}{% set cpsDocsCount = cpsDocsCount + 1 %}{% endif %}
    {% endfor %}
{% endfor %}

{% macro filenameFromUrl(url) %}
    {% if url %}{{ url.split('/').pop() }}{% else %}Untitled{% endif %}
{% endmacro %}

{# Single card renderer so meta stays consistent for all sections #}
{% macro renderCard(m, cm) %}
    {% set linkText = m.Title or filenameFromUrl(m.myFileUrl) %}
    {% set _status = (m.materialStatus or 'New') %}
    <article
            class="dcf-material-card"
            data-item-id="{{ m.ItemId }}"
            data-material-status="{{ _status }}"
            data-is-new="{{ "true" if (_status | lower) == "new" else "false" }}"
            {% if m.date %}data-material-date="{{ m.date }}"{% endif %}
    >
        <div class="dcf-material-card__main">

      <span
              class="dcf-material-card__badge"
              data-raw-status="{{ _status }}"
              {% if (_status | lower) != 'new' %}hidden{% endif %}
      >New</span>

            <h3 class="dcf-material-card__title">

                {% if m.item %}
                    <span class="dcf-material-card__item-number" aria-hidden="true">
            {{ m.item }}
          </span>
                    <span class="govuk-visually-hidden">Item </span>
                {% endif %}

                {% if m.myFileUrl %}

                    <a href="#"
                       class="govuk-link js-material-link"
                       rel="noreferrer"
                       role="button"
                       data-file-url="{{ m.myFileUrl }}"
                       data-title="{{ linkText }}"
                    >{{ linkText }}</a>

                    {% set __meta__ = {
                        ItemId: m.ItemId,
                        Type: m.Type,
                        date: m.date,
                        Status: m.Status,

                        Material: {
                            item: m.item,
                            Type: m.Type,
                            Title: m.Title,
                            myFileUrl: m.myFileUrl,
                            materialStatus: _status,
                            isEvidence: m.isEvidence,
                            Reference: m.Reference,
                            ProducedbyWitnessId: m.ProducedbyWitnessId,
                            MaterialClassification: m.MaterialClassification,
                            MaterialType: m.MaterialType,
                            SentExternally: m.SentExternally,
                            RelatedParticipantId: m.RelatedParticipantId,
                            Incident: m.Incident,
                            Location: m.Location,
                            PeriodFrom: m.PeriodFrom,
                            PeriodTo: m.PeriodTo,
                            Description: m.Description,

                            StatementNumber: m.StatementNumber,
                            StatementMadeOn: m.StatementMadeOn,
                            WhenRecorded: m.WhenRecorded,
                            WhereRecorded: m.WhereRecorded,
                            WhenTranscribed: m.WhenTranscribed,
                            PresentationOfImpactStatement: m.PresentationOfImpactStatement,
                            AppropriateAdult: m.AppropriateAdult,

                            exhibitName: m.exhibitName,
                            exhibitDescription: m.exhibitDescription,
                            RelatedPerson1: m.RelatedPerson1,
                            RelatedPerson2: m.RelatedPerson2,

                            policeDisclosure: m.policeDisclosure,
                            cpsDisclosure: m.cpsDisclosure
                        },

                        RelatedMaterials: m.RelatedMaterials,
                        DigitalRepresentation: cm.DigitalRepresentation,
                        PoliceMaterial: cm.PoliceMaterial,
                        CPSMaterial: cm.CPSMaterial
                    } %}

                    <script type="application/json" class="js-material-data">{{ __meta__ | dump | safe }}</script>
                {% else %}
                    {{ linkText }}
                {% endif %}
            </h3>

            {% if m.date %}
                <p class="dcf-material-card__meta dcf-material-card__meta--with-note">
          <span class="dcf-material-card__date">
            Date: {{ m.date }}
          </span>

                    <a href="#" class="govuk-link dcf-note-link" data-action="open-notes">
            <span class="dcf-note-link__icon" aria-hidden="true">
              <img
                      src="/public/files/speech-bubble-svgrepo-com.svg"
                      alt=""
                      width="18"
                      height="18">
              <span class="dcf-material-card__comment is-unread"></span>
            </span>
                        <span class="dcf-note-link__text">Add a note</span>
                    </a>

                </p>
            {% endif %}

        </div>
    </article>
{% endmacro %}

{% macro renderSection(typeLower, addListMargins=false) %}
    {% set hasAny = false %}
    <ul class="dcf-material-list{% if addListMargins %} govuk-!-margin-top-1 govuk-!-margin-bottom-1{% endif %}">
        {% for m in items %}
            {% if (m.Type | lower) == typeLower %}
                {% set hasAny = true %}
                <li class="govuk-!-margin-bottom-2">{{ renderCard(m, cm) }}</li>
            {% endif %}
        {% endfor %}
    </ul>
    {% if not hasAny %}<p class="govuk-hint">No items yet.</p>{% endif %}
{% endmacro %}

{# ✅ MUST be defined before unusedHtml uses it #}
{% macro renderSectionForTypes(typeLowers, addListMargins=false) %}
    {% set hasAny = false %}
    <ul class="dcf-material-list{% if addListMargins %} govuk-!-margin-top-1 govuk-!-margin-bottom-1{% endif %}">
        {% for m in items %}
            {% set mt = (m.Type | lower) %}
            {% if mt in typeLowers %}
                {% set hasAny = true %}
                <li class="govuk-!-margin-bottom-2">{{ renderCard(m, cm) }}</li>
            {% endif %}
        {% endfor %}
    </ul>
    {% if not hasAny %}<p class="govuk-hint">No items yet.</p>{% endif %}
{% endmacro %}

{# ---------- Unused combined accordion content ---------- #}
{% set unusedHtml %}
    <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Non-sensitive</h3>
    {{ renderSection('unused non-sensitive') }}

    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

    <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Sensitives</h3>
    {{ renderSectionForTypes(['sensitive', 'unused sensitive']) }}
{% endset %}

{# ---------- CPS generated documents accordion content ---------- #}
{% set cpsDocumentsHtml %}
    {% set hasAnyCpsDocs = false %}

    {% if gd.caseDocuments | length %}
        {% for doc in gd.caseDocuments %}
            {% if doc.lastGenerated %}{% set hasAnyCpsDocs = true %}{% endif %}
        {% endfor %}
    {% endif %}

    {% if not hasAnyCpsDocs %}
        {% for defendant in (gd.defendants or []) %}
            {% for doc in (defendant.documents or []) %}
                {% if doc.lastGenerated %}{% set hasAnyCpsDocs = true %}{% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}

    {% if not hasAnyCpsDocs %}
        {% for witness in (gd.witnesses or []) %}
            {% for doc in (witness.documents or []) %}
                {% if doc.lastGenerated %}{% set hasAnyCpsDocs = true %}{% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}

    {% if not hasAnyCpsDocs %}
        <p class="govuk-hint">No CPS documents generated yet.</p>
    {% else %}

        {# --- Case documents --- #}
        {% set hasCaseDocs = false %}
        {% for doc in (gd.caseDocuments or []) %}
            {% if doc.lastGenerated %}{% set hasCaseDocs = true %}{% endif %}
        {% endfor %}

        {% if hasCaseDocs %}
            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Case documents</h3>
            <ul class="dcf-material-list govuk-!-margin-top-1 govuk-!-margin-bottom-1">
                {% for doc in gd.caseDocuments %}
                    {% if doc.lastGenerated %}
                        {% set normDoc = {
                            ItemId: doc.id,
                            Title: doc.label,
                            Type: "CPS Document",
                            materialStatus: "Generated",
                            date: doc.lastGenerated,
                            myFileUrl: null
                        } %}
                        <li class="govuk-!-margin-bottom-2">{{ renderCard(normDoc, cm) }}</li>
                    {% endif %}
                {% endfor %}
            </ul>
        {% endif %}

        {# --- Defendant documents --- #}
        {% for defendant in (gd.defendants or []) %}
            {% set hasDefDocs = false %}
            {% for doc in (defendant.documents or []) %}
                {% if doc.lastGenerated %}{% set hasDefDocs = true %}{% endif %}
            {% endfor %}

            {% if hasDefDocs %}
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ defendant.name }}</h3>
                <ul class="dcf-material-list govuk-!-margin-top-1 govuk-!-margin-bottom-1">
                    {% for doc in defendant.documents %}
                        {% if doc.lastGenerated %}
                            {% set normDoc = {
                                ItemId: defendant.id ~ "_" ~ doc.id,
                                Title: doc.label,
                                Type: "CPS Document",
                                materialStatus: "Generated",
                                date: doc.lastGenerated,
                                myFileUrl: null
                            } %}
                            <li class="govuk-!-margin-bottom-2">{{ renderCard(normDoc, cm) }}</li>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        {% endfor %}

        {# --- Witness documents --- #}
        {% for witness in (gd.witnesses or []) %}
            {% set hasWitDocs = false %}
            {% for doc in (witness.documents or []) %}
                {% if doc.lastGenerated %}{% set hasWitDocs = true %}{% endif %}
            {% endfor %}

            {% if hasWitDocs %}
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ witness.name }}</h3>
                <ul class="dcf-material-list govuk-!-margin-top-1 govuk-!-margin-bottom-1">
                    {% for doc in witness.documents %}
                        {% if doc.lastGenerated %}
                            {% set normDoc = {
                                ItemId: witness.id ~ "_" ~ doc.id,
                                Title: doc.label,
                                Type: "CPS Document",
                                materialStatus: "Generated",
                                date: doc.lastGenerated,
                                myFileUrl: null
                            } %}
                            <li class="govuk-!-margin-bottom-2">{{ renderCard(normDoc, cm) }}</li>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        {% endfor %}

    {% endif %}
{% endset %}

{% set embedded = params.embeddedInMaterialsCardsPanel %}
{# ---------- Layout ---------- #}
{% if embedded %}
    <div class="dcf-materials-panel dcf-materials-accordion">
        <div class="dcf-materials-header">
            <form class="dcf-materials-search" action="/materials/search" method="get" role="search">
                <label class="govuk-label govuk-!-font-weight-bold" for="materials-search">Search documents</label>
                <div class="dcf-materials-search__row">
                    <input class="govuk-input dcf-materials-search__input" id="materials-search" name="q"
                           type="search">
                    <button class="govuk-button dcf-materials-search__button" type="submit"
                            data-module="govuk-button">Search
                    </button>
                </div>
                <input type="hidden" name="caseId" value="{{ params.caseMaterials.caseId }}">
            </form>
        </div>

        {{ govukAccordion({
            id: "materials-accordion",
            classes: "dcf-accordion",
            items: [
                { heading: { text: "Statements (" ~ statementsCount ~ ")" },                   content: { html: renderSection('statement', true) } },
                { heading: { text: "Exhibits (" ~ exhibitsCount ~ ")" },                     content: { html: renderSection('exhibit') } },
                { heading: { text: "MG forms (" ~ mgFormsCount ~ ")" },                     content: { html: renderSection('mg forms') } },
                { heading: { text: "CPS generated documents (" ~ cpsDocsCount ~ ")" },      content: { html: cpsDocumentsHtml } },
                { heading: { text: "Other documents (" ~ otherCount ~ ")" },               content: { html: renderSection('other material') } },
                { heading: { text: "Unused (" ~ unusedCount ~ ")" },                        content: { html: unusedHtml } }
            ]
        }) }}
    </div>
{% else %}
    <div class="govuk-grid-row dcf-materials-layout">
        <div class="govuk-grid-column-one-quarter">
            <div class="dcf-materials-panel dcf-materials-accordion">
                <div class="dcf-materials-header">
                    <form class="dcf-materials-search" action="/materials/search" method="get" role="search">
                        <label class="govuk-label govuk-!-font-weight-bold" for="materials-search">Search
                            documents</label>
                        <div class="dcf-materials-search__row">
                            <input class="govuk-input dcf-materials-search__input" id="materials-search" name="q"
                                   type="search">
                            <button class="govuk-button dcf-materials-search__button" type="submit"
                                    data-module="govuk-button">Search
                            </button>
                        </div>
                        <input type="hidden" name="caseId" value="{{ params.caseMaterials.caseId }}">
                    </form>
                </div>

                {{ govukAccordion({
                    id: "materials-accordion",
                    classes: "dcf-accordion",
                    items: [
                        { heading: { text: "Statements (" ~ statementsCount ~ ")" },                   content: { html: renderSection('statement', true) } },
                        { heading: { text: "Exhibits (" ~ exhibitsCount ~ ")" },                     content: { html: renderSection('exhibit') } },
                        { heading: { text: "MG forms (" ~ mgFormsCount ~ ")" },                     content: { html: renderSection('mg forms') } },
                        { heading: { text: "CPS generated documents (" ~ cpsDocsCount ~ ")" },      content: { html: cpsDocumentsHtml } },
                        { heading: { text: "Other documents (" ~ otherCount ~ ")" },               content: { html: renderSection('other material') } },
                        { heading: { text: "Unused (" ~ unusedCount ~ ")" },                        content: { html: unusedHtml } }
                    ]
                }) }}
            </div>
        </div>

        <div class="govuk-grid-column-three-quarters">

            {# --- SEARCH STATUS (shown only after a search submit) --- #}
            <div id="search-status" class="govuk-!-margin-bottom-3" aria-live="polite" hidden>
                <div data-zero>
                    <div class="dcf-search-meta govuk-!-margin-bottom-0">
                        No results for "<span data-search-term></span>".
                    </div>
                </div>

                <div data-some hidden>
                    <div class="dcf-search-status-row">
                        <p class="dcf-search-meta dcf-search-status-row__meta">
                            <strong><span data-search-count>0</span></strong>
                            results for "<span data-search-term></span>"
                            <span data-role="back-to-documents-sep" hidden> | </span>
                            <a href="#" class="govuk-link" data-action="back-to-documents" hidden>Back to document
                                viewer</a>
                        </p>

                        <div class="dcf-search-order dcf-search-status-row__order"
                             aria-label="Search result sort options">
                            <span class="dcf-search-order__label"><b>Sort by: </b> </span>

                            <a href="#"
                               class="govuk-link dcf-search-order__link"
                               data-sort-key="date"
                               aria-pressed="true">
                                Date added
                            </a>

                            <span aria-hidden="true" class="dcf-search-order__separator">&nbsp; | &nbsp;</span>

                            <a href="#"
                               class="govuk-link dcf-search-order__link"
                               data-sort-key="results"
                               aria-pressed="false">
                                Results per document
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div id="material-viewer" class="dcf-viewer" data-component="material-viewer" hidden aria-live="polite">
                <p class="govuk-body govuk-!-margin-bottom-3">Select a material from the list to preview it here.</p>
            </div>
        </div>
    </div>
{% endif %}
